# Copy to .deploy.env and fill in. .deploy.env is gitignored — never
# commit it, and never paste its contents into a chat.
#
# Find these in Bluehost: cPanel > Files > FTP Accounts, and
# cPanel > Advanced > SSH Access to enable SSH and upload a key.

# Usually your server hostname, e.g. box5309.bluehost.com — or the
# server IP. Not "kevinrocci.com": that resolves to the shared front
# end, not the SSH host.
SFTP_HOST=

# The cPanel username, or a dedicated FTP user you create.
SFTP_USER=

# 22 for SFTP/SSH. Bluehost sometimes uses 2222 on shared plans.
SFTP_PORT=22

# Absolute path to the document root. For a primary domain this is
# almost always /home/<user>/public_html
REMOTE_DIR=/home/CHANGEME/public_html

# Optional. Path to a private key, e.g. ~/.ssh/bluehost_ed25519.
# Leave blank to be prompted for a password on every run.
SSH_KEY=
